# Copy to .env (local, git-ignored) or set these in the Vercel dashboard.
# Next.js loads .env automatically in development; on Vercel set them as project env vars.
# Never commit real values.

# Canonical origin used to build QR URLs and to validate Origin/Referer on mutations.
PUBLIC_BASE_URL=http://localhost:3000

# file  -> local snapshot at ./data/pglite/snapshot.tar.gz (default outside production)
# blob  -> Vercel Blob snapshot at SNAPSHOT_PATH
STORAGE_MODE=file

# Blob path of the database snapshot. Give preview deployments a different path so they
# never write the production snapshot (or omit the Blob token so they fail closed).
SNAPSHOT_PATH=db/snapshot.tar.gz

# Injected by the Vercel Blob store integration. Required when STORAGE_MODE=blob.
# BLOB_READ_WRITE_TOKEN=

# >= 32 random bytes. Rotating it invalidates every live QR code at once.
# Generate: openssl rand -base64 48
QR_CHALLENGE_SECRET=replace-with-at-least-32-random-characters

# Session lifetime in seconds (default 30 days).
SESSION_TTL_SECONDS=2592000

# How long a scanned-but-uncompleted attempt stays valid (default 2 minutes).
PENDING_ATTEMPT_TTL_SECONDS=120

# Seconds a rotated code keeps being accepted (default 3).
QR_ACCEPTANCE_OVERLAP_SECONDS=3

# Display timezone for day boundaries and formatting. Storage stays UTC.
DISPLAY_TIMEZONE=Asia/Tehran

# true on HTTPS. Set false only for local plain-HTTP development.
COOKIE_SECURE=false

# true on Vercel (platform sets x-forwarded-for); false when exposed directly.
TRUST_FORWARDED_FOR=false

# First-run administrator password. Defaults to "admin"; change it in the UI immediately.
BOOTSTRAP_ADMIN_PASSWORD=admin

# Required bearer value for /api/v1/cron/cleanup. Vercel Cron sends it automatically
# when this variable exists in the project.
# CRON_SECRET=
