{
  "name": "qr-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "QR-based attendance collection with a PGlite snapshot database on Vercel Blob",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run migrations:embed && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrations:generate": "drizzle-kit generate",
    "migrations:embed": "node scripts/embed-migrations.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@vercel/blob": "2.8.2",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
