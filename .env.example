# Local-only values. The server does not auto-load .env; export these variables before running.
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_PATH=./data/attendance.db
COOKIE_SECURE=false
SESSION_TTL=720h
PENDING_ATTEMPT_TTL=2m
QR_ACCEPTANCE_OVERLAP=3s
DISPLAY_TIMEZONE=Asia/Tehran
# Generate a unique random value for each environment; do not reuse it across production and preview.
QR_CHALLENGE_SECRET=replace-with-at-least-32-random-bytes
# Optional. Defaults to admin for local first run only.
BOOTSTRAP_ADMIN_PASSWORD=admin
